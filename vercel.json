{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/shop/:productId",
      "destination": "/shop/:productId.html"
    },
    {
      "source": "/guides/ontario-fish-stocking-records",
      "destination": "/guides/ontario-fish-stocking-records.html"
    },
    {
      "source": "/guides/best-fishing-app-ontario",
      "destination": "/guides/best-fishing-app-ontario.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/best-fishing-app",
      "destination": "/best-fishing-app.html"
    },
    {
      "source": "/fishai-vs-fishbrain",
      "destination": "/fishai-vs-fishbrain.html"
    },
    {
      "source": "/fishai-vs-fishangler",
      "destination": "/fishai-vs-fishangler.html"
    },
    {
      "source": "/listicle",
      "destination": "/listicle.html"
    },
    {
      "source": "/how-to-choose",
      "destination": "/how-to-choose.html"
    },
    {
      "source": "/academy",
      "destination": "/academy.html"
    },
    {
      "source": "/seo",
      "destination": "/seo.html"
    },
    {
      "source": "/merch",
      "destination": "/merch.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
