{
  "name": "fish-ai-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender-seo.mjs && npm run verify:seo",
    "verify:seo": "node --test scripts/verify-public-seo.test.mjs",
    "test": "tsx --test server/utils/session.test.ts server/utils/ontarioLakeSearch.test.ts server/security.regression.test.ts src/utils/mapData.test.ts src/utils/verifiedRepairs.test.ts",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "server": "tsx --env-file-if-exists=.env server/server.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "resend": "^6.20.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2"
  }
}
